{
  "name": "@xxxsen/retrom-runtime",
  "version": "0.44.0-rc.4",
  "description": "Host-independent browser game runtimes with a shared lifecycle and checkpoint contract",
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "contracts/content-io/v1"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "lint": "eslint src scripts tests --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev:watch": "node scripts/dev-watch.mjs",
    "dev:provider:watch": "node scripts/pfb-provider-watch.mjs",
    "candidate:build": "node scripts/build-candidate.mjs",
    "package:check": "node scripts/package-check.mjs",
    "provider:input:prepare": "node scripts/emulatorjs-provider-input.mjs prepare",
    "provider:input:check": "node scripts/emulatorjs-provider-input.mjs check",
    "provider:build": "npm run build && npm run provider:input:prepare && RETROM_PROVIDER_BUILD_ONLY=1 node scripts/build-release.mjs",
    "provider:check": "npm run provider:input:check && node scripts/provider-release.mjs check",
    "release:build": "npm run build && npm run provider:input:prepare && node scripts/build-release.mjs",
    "content-io:preflight": "node scripts/content-io/preflight.mjs",
    "content-io:inventory": "node scripts/content-io/inventory.mjs",
    "content-io:boundaries": "node scripts/content-io/boundaries.mjs",
    "content-io:stage": "node scripts/content-io/stage.mjs",
    "content-io:evidence:check": "node scripts/content-io/evidence.mjs",
    "content-io:test": "node scripts/content-io/test.mjs",
    "content-io:browser": "node scripts/content-io/browser.mjs",
    "content-io:assets": "node scripts/content-io/build-assets.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "fflate": "0.8.3",
    "nostalgist": "0.20.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "esbuild": "0.27.0",
    "eslint": "9.39.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.8"
  }
}
